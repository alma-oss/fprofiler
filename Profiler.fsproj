<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <OutputType>Library</OutputType>
        <PackageId>Alma.Profiler</PackageId>
        <Version>7.0.0</Version>
        <Authors>Almacareer</Authors>
        <Description>Library for a Web App Profiler.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/alma-oss/fprofiler.git</RepositoryUrl>
        <PackageProjectUrl>https://github.com/alma-oss/fprofiler</PackageProjectUrl>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="src/Utils.fs" />

        <Compile Include="src/Errors.fs" />
        <Compile Include="src/Resources.fs" />
        <Compile Include="src/Queries.fs" />
        <Compile Include="src/Profiler.fs" />
    </ItemGroup>

    <Import Project=".paket\Paket.Restore.targets" />
</Project>
